{
  "manifest_version": 3,
  "name": "QG da PRF — Rastreador Caveira",
  "version": "3.0.2",
  "description": "Rastreia e diagnostica cada questão resolvida no Projeto Caveira, sincronizando pontos fortes e fracos no QG da PRF.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://*.caveira.com/*",
    "*://caveira.com/*",
    "*://*.caveira.com.br/*",
    "*://caveira.com.br/*",
    "*://*.projetocaveira.com.br/*",
    "*://projetocaveira.com.br/*",
    "*://*.projetocaveira.com/*",
    "*://projetocaveira.com/*",
    "*://*.mediadelivery.net/*",
    "*://*.supabase.co/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://blk002.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QG da PRF — Rastreador Caveira",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.caveira.com/*",
        "*://caveira.com/*",
        "*://*.caveira.com.br/*",
        "*://caveira.com.br/*",
        "*://*.projetocaveira.com.br/*",
        "*://projetocaveira.com.br/*",
        "*://*.projetocaveira.com/*",
        "*://projetocaveira.com/*"
      ],
      "js": ["api_sniffer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.caveira.com/*",
        "*://caveira.com/*",
        "*://*.caveira.com.br/*",
        "*://caveira.com.br/*",
        "*://*.projetocaveira.com.br/*",
        "*://projetocaveira.com.br/*",
        "*://*.projetocaveira.com/*",
        "*://projetocaveira.com/*"
      ],
      "js": ["treeMatcher.js", "caveiraResolver.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.mediadelivery.net/*"
      ],
      "js": ["player_bridge.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://blk002.github.io/*"
      ],
      "js": ["qg_bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["caveira_arvore.json"],
      "matches": [
        "*://*.caveira.com/*",
        "*://caveira.com/*",
        "*://*.caveira.com.br/*",
        "*://caveira.com.br/*",
        "*://*.projetocaveira.com.br/*",
        "*://projetocaveira.com.br/*",
        "*://*.projetocaveira.com/*",
        "*://projetocaveira.com/*"
      ]
    }
  ]
}
