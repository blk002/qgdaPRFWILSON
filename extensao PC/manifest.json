{
  "manifest_version": 3,
  "name": "QG da PRF — Rastreador Caveira",
  "version": "3.4.0",
  "description": "Rastreia e diagnostica cada questão resolvida no Projeto Caveira, sincronizando pontos fortes e fracos no QG da PRF.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://*.caveira.com/*",
    "*://caveira.com/*",
    "*://*.caveira.com.br/*",
    "*://caveira.com.br/*",
    "*://*.projetocaveira.com.br/*",
    "*://projetocaveira.com.br/*",
    "*://*.projetocaveira.com/*",
    "*://projetocaveira.com/*",
    "*://*.mediadelivery.net/*",
    "https://mhjvzilukchpfbfmzjwv.supabase.co/*",
    "https://blk002.github.io/*"
  ],
  "commands": {
    "mark-doubt": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Marcar questão atual como Dúvida"
    },
    "mark-guess": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Marcar questão atual como Chute"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QG da PRF — Rastreador Caveira",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.caveira.com/*",
        "*://caveira.com/*",
        "*://*.caveira.com.br/*",
        "*://caveira.com.br/*",
        "*://*.projetocaveira.com.br/*",
        "*://projetocaveira.com.br/*",
        "*://*.projetocaveira.com/*",
        "*://projetocaveira.com/*"
      ],
      "exclude_matches": [
        "*://loja.caveira.com/*",
        "*://*.loja.caveira.com/*",
        "*://checkout.caveira.com/*",
        "*://blog.caveira.com/*",
        "*://www.caveira.com/*",
        "*://pay.caveira.com/*",
        "*://pagamento.caveira.com/*",
        "*://pagamentos.caveira.com/*",
        "*://loja.caveira.com.br/*",
        "*://checkout.caveira.com.br/*",
        "*://loja.projetocaveira.com.br/*",
        "*://checkout.projetocaveira.com.br/*",
        "*://www.projetocaveira.com.br/*",
        "*://blog.projetocaveira.com.br/*"
      ],
      "js": ["api_sniffer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.caveira.com/*",
        "*://caveira.com/*",
        "*://*.caveira.com.br/*",
        "*://caveira.com.br/*",
        "*://*.projetocaveira.com.br/*",
        "*://projetocaveira.com.br/*",
        "*://*.projetocaveira.com/*",
        "*://projetocaveira.com/*"
      ],
      "exclude_matches": [
        "*://loja.caveira.com/*",
        "*://*.loja.caveira.com/*",
        "*://checkout.caveira.com/*",
        "*://blog.caveira.com/*",
        "*://www.caveira.com/*",
        "*://pay.caveira.com/*",
        "*://pagamento.caveira.com/*",
        "*://pagamentos.caveira.com/*",
        "*://loja.caveira.com.br/*",
        "*://checkout.caveira.com.br/*",
        "*://loja.projetocaveira.com.br/*",
        "*://checkout.projetocaveira.com.br/*",
        "*://www.projetocaveira.com.br/*",
        "*://blog.projetocaveira.com.br/*"
      ],
      "js": ["treeMatcher.js", "caveiraResolver.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.mediadelivery.net/*"
      ],
      "js": ["player_bridge.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://blk002.github.io/*"
      ],
      "js": ["qg_bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["caveira_arvore.json"],
      "matches": [
        "*://*.caveira.com/*",
        "*://caveira.com/*",
        "*://*.caveira.com.br/*",
        "*://caveira.com.br/*",
        "*://*.projetocaveira.com.br/*",
        "*://projetocaveira.com.br/*",
        "*://*.projetocaveira.com/*",
        "*://projetocaveira.com/*"
      ]
    }
  ]
}
